{
  "name": "@modlycrew/c2e",
  "version": "0.0.2.1",
  "description": "c2e is a Mocha/Chai & Cypress.io test scaffolding helper to produce end-to-end test files mapping organizational (c)apabilties to(2) (e)xpected outcomes / criteria (i.e. expect(A).to.equal(B), cy.get().contains(), etc)",
  "main": "c2e.js",
  "bin": {
    "c2e": "./c2e.js"
  },
  "scripts": {
    "test": "npx cypress open"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/modlycrew/c2e.git"
  },
  "keywords": [
    "cypress.io",
    "mocha",
    "chai",
    "test",
    "scaffold",
    "end",
    "to",
    "end",
    "e2e",
    "javascript"
  ],
  "author": "community@modlycrew.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/modlycrew/c2e/issues"
  },
  "homepage": "https://github.com/modlycrew/c2e#readme",
  "dependencies": {
    "ajv": "^8.11.2",
    "ajv-formats": "^2.1.1",
    "ajv-merge-patch": "^5.0.1",
    "chalk": "^4.1.2",
    "clear": "^0.1.0",
    "figlet": "^1.5.2",
    "js-yaml": "^4.1.0"
  }
}
